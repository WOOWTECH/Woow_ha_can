{
 "id": "cia402_drive_monitor",
 "version": 1,
 "name": {
  "en": "CANopen drive monitor (CiA 402)",
  "zh-Hant": "CANopen 驅動器監看（CiA 402）"
 },
 "category": "industrial",
 "description": {
  "en": "Servo, stepper and frequency drives on CANopen (CiA 402, e.g. maxon EPOS4): the drive state from the statusword, fault and warning, and with polling on the actual position, velocity, torque, operating mode and error code read with SDO. It only reads: it never enables or moves a drive.",
  "zh-Hant": "CANopen 上的伺服、步進、變頻驅動器（CiA 402，例如 maxon EPOS4）：由狀態字判斷驅動器狀態、故障與警告；開啟「主動輪詢」後再用 SDO 讀實際位置、速度、扭矩、運轉模式和錯誤碼。只讀取，不會啟用或移動驅動器。"
 },
 "bitrate": null,
 "transmits": true,
 "manufacturer": "CANopen",
 "model": "CiA 402 drive",
 "default_name": {
  "en": "Drive",
  "zh-Hant": "驅動器"
 },
 "source": [
  "CiA 402 (facts only)",
  "maxon EPOS4 firmware specification (objects, statusword table)",
  "python canopen (MIT; state masks)"
 ],
 "license": "Facts from public documents, written by WOOWTECH; MIT",
 "verified": [
  "Statusword and SDO frames from the research scripts (EPOS4 objects)"
 ],
 "confidence": "high",
 "notes": {
  "en": "TPDO1 carries the statusword on most drives (EPOS4: enabled by default); without it, adopt the SDO state entities. Velocity units depend on the drive (EPOS4: rpm), positions are increments. Only one device should poll a drive with SDO: leave polling off where a PLC talks to it.",
  "zh-Hant": "多數驅動器的 TPDO1 帶狀態字（EPOS4 出廠就開）；沒有的話改用「（SDO）」的狀態實體。速度單位依驅動器而定（EPOS4：rpm），位置是脈衝數。同一個驅動器只應有一個設備用 SDO 輪詢：已有 PLC 跟它通訊時請不要開輪詢。"
 },
 "params": [
  {
   "key": "node_id",
   "default": 1,
   "description": {
    "en": "Node ID (1-127)",
    "zh-Hant": "節點編號（1–127）"
   }
  },
  {
   "key": "heartbeat_ms",
   "default": 1000,
   "description": {
    "en": "The node's heartbeat period in ms (object 0x1017)",
    "zh-Hant": "節點的 heartbeat 週期，毫秒（物件 0x1017）"
   }
  }
 ],

 "default_name": {
  "en": "Engine",
  "zh-Hant": "引擎"
 },
 "source": [
  "FMS-Standard v02.00 (FMS working group)",
  "Hatz E1 CAN protocol (2024)",
  "Vector AN-ION-1-3100 Introduction to J1939",
  "canboat j1939 data (Apache-2.0)",
  "pretty_j1939 (Apache-2.0)"
 ],
 "license": "Facts from public documents, written by WOOWTECH; MIT. The full SPN list (SAE J1939DA) is licensed by SAE and is not included: import your own DBC for more.",
 "verified": [
  "Example frames from the FMS standard and Hatz documents"
 ],
 "confidence": "high",
 "notes": {
  "en": "Fields marked as from open sources only are disabled by default. 0xFE / 0xFF in a field means error / not available and shows as unavailable.",
  "zh-Hant": "只有開源資料佐證的欄位預設停用。欄位值 0xFE／0xFF 代表錯誤／無資料，會顯示為無法使用。"
 },

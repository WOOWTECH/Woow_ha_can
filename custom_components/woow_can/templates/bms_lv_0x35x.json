{
 "id": "bms_lv_0x35x",
 "version": 1,
 "name": {
  "en": "Low-voltage battery BMS (Pylontech / SMA / Victron 0x35x)",
  "zh-Hant": "低壓電池 BMS（Pylontech／SMA／Victron 0x35x）"
 },
 "category": "battery",
 "description": {
  "en": "Rack and wall batteries that report to their inverter on 0x351-0x35F (Pylontech, BYD LVS, Seplos, REC, JK in Pylon mode, most 48 V rack batteries). Listen between the battery and the inverter: state of charge, voltage, current, power, temperature, charge and discharge limits, alarms.",
  "zh-Hant": "接在電池和逆變器之間監聽 0x351–0x35F（Pylontech、BYD LVS、Seplos、REC、Pylon 模式的 JK，以及大多數 48 V 機櫃電池）：電量、電壓、電流、功率、溫度、充放電限制和告警。"
 },
 "bitrate": 500000,
 "transmits": false,
 "manufacturer": "Battery BMS",
 "model": "CAN 0x35x",
 "default_name": {
  "en": "Battery",
  "zh-Hant": "電池"
 },
 "source": [
  "SMA: Connecting batteries with external BMS to Sunny Island 6.0H-11 (FSS-ConnectingBat-TI-en-10, 2013)",
  "Pylontech: Low Voltage Battery System CANBUS Protocol V1.3 (2019-03-01)",
  "REC BMS manuals for Victron and SMA",
  "dfch/BydCanProtocol (MIT): BYD LVS to Victron capture"
 ],
 "license": "Facts from vendor documents and public captures, written by WOOWTECH; MIT",
 "verified": [
  "Pylontech US3000 x10 -> Sofar ME3000SP capture (setfirelabs, 2021)",
  "BYD LVS -> Victron Venus OS 3.00 capture (dfch/BydCanProtocol)"
 ],
 "confidence": "high",
 "notes": {
  "en": "Current is positive while charging (0x356). The inverter's 0x305 counts the other way round. Victron's extensions (0x370 and up) are community knowledge: Victron's BMS protocol is under NDA.",
  "zh-Hant": "電流正值＝充電（0x356）；逆變器的 0x305 正負號相反。Victron 的延伸訊框（0x370 之後）是社群整理的資料，Victron 的 BMS 協定受保密協議限制。"
 },
 "params": [],

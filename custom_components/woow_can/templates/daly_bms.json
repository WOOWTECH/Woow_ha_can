     "entity": {
      "key": "battery.fault",
      "name": {
       "en": "BMS fault",
       "zh-Hant": "BMS 故障"
      },
      "platform": "binary_sensor",
      "device_class": "problem",
      "enabled": true
     }
    }
   ]
  }
 ],
 "requests": [

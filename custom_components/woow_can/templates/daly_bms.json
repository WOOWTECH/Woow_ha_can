    },
    {
     "name": "ChargeMos",
     "start": 15,
     "length": 8,
     "byte_order": "big",
     "signed": false,
     "entity": {
      "key": "battery.charge_mos",
      "name": {
       "en": "Charge MOS",
       "zh-Hant": "充電 MOS"
      },
      "platform": "binary_sensor"
     }
    },
    {
     "name": "DischargeMos",
     "start": 23,
     "length": 8,
     "byte_order": "big",
     "signed": false,
     "entity": {
      "key": "battery.discharge_mos",
      "name": {
       "en": "Discharge MOS",
       "zh-Hant": "放電 MOS"
      },
      "platform": "binary_sensor"
     }
    },
    {
     "name": "BmsLife",
     "start": 31,
     "length": 8,
     "byte_order": "big",
     "signed": false
    },
    {
     "name": "RemainingCapacity",
     "start": 39,
     "length": 32,
     "byte_order": "big",
     "signed": false,
     "factor": 0.001,
     "unit": "Ah",
     "entity": {
      "key": "battery.remaining_capacity",
      "name": {
       "en": "Remaining capacity",
       "zh-Hant": "剩餘容量"
      }
     }
    }
   ]
  },
  {
   "name": "Faults_98",
   "can_id": "0x18980000 | (host_address << 8) | bms_address",
   "length": 8,
   "cycle_ms": 5000,
   "signals": [
    {
     "name": "FaultBits",
     "start": 7,
     "length": 56,
     "byte_order": "big",
     "signed": false,
     "entity": {
      "key": "battery.fault_bits",
      "name": {
       "en": "Fault bits",
       "zh-Hant": "故障位元"
      },
      "format": "hex",
      "enabled": false
     }
    },
    {
     "name": "FaultCode",
     "start": 63,
     "length": 8,
     "byte_order": "big",
     "signed": false
    },
    {
     "name": "Fault",
     "start": 0,
     "length": 0,
     "byte_order": "little",
     "signed": false,
     "derive": {
      "op": "nonzero",
      "of": [

   "length": 8,
   "cycle_ms": 2000,
   "signals": [
    {
     "name": "MaxTemperature",
     "start": 7,
     "length": 8,
     "byte_order": "big",
     "signed": false,
     "offset": -40,
     "unit": "°C",
     "entity": {
      "key": "battery.max_temperature",
      "name": {
       "en": "Highest temperature",
       "zh-Hant": "最高溫度"
      }
     }
    },
    {
     "name": "MaxTemperatureSensor",
     "start": 15,
     "length": 8,
     "byte_order": "big",
     "signed": false
    },
    {
     "name": "MinTemperature",
     "start": 23,
     "length": 8,
     "byte_order": "big",
     "signed": false,
     "offset": -40,
     "unit": "°C",
     "entity": {
      "key": "battery.min_temperature",
      "name": {
       "en": "Lowest temperature",
       "zh-Hant": "最低溫度"
      }
     }
    },
    {
     "name": "MinTemperatureSensor",
     "start": 31,
     "length": 8,
     "byte_order": "big",
     "signed": false
    }
   ]
  },
  {
   "name": "Mos_93",

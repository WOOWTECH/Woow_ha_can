{
 "id": "cia401_io",
 "version": 1,
 "name": {
  "en": "CANopen I/O module (CiA 401)",
  "zh-Hant": "CANopen I/O 模組（CiA 401）"
 },
 "category": "industrial",
 "description": {
  "en": "Digital inputs and outputs and analogue inputs of a CiA 401 module (ICP DAS CAN-2053C / 2057C / 2017C and similar): inputs as binary sensors from TPDO1, outputs as switches over RPDO1, analogue inputs read with SDO. Outputs and the NMT start button appear only after you allow writing for the device; the analogue inputs are read only while polling is on.",
  "zh-Hant": "CiA 401 模組（ICP DAS CAN-2053C／2057C／2017C 等）的數位輸入輸出與類比輸入：輸入由 TPDO1 變成二元感測器、輸出經 RPDO1 變成開關、類比輸入用 SDO 讀取。要在裝置上「允許寫入」後才會出現輸出開關和 NMT 啟動按鈕；開啟「主動輪詢」才會讀類比輸入。"
 },
 "bitrate": null,
 "transmits": true,
 "manufacturer": "CANopen",
 "model": "CiA 401 I/O",
 "default_name": {
  "en": "I/O module",
  "zh-Hant": "I/O 模組"
 },
 "source": [
  "CiA 301 v4.02 and CiA 401 (facts only)",
  "ICP DAS CAN-2000C series manuals (example frames)",
  "CANopenNode (Apache-2.0)",
  "python canopen (MIT)"
 ],
 "license": "Facts from public documents, written by WOOWTECH; MIT",
 "verified": [
  "TPDO1 / RPDO1 / SDO frames from the ICP DAS manuals (CAN-2053C, CAN-2057C, CAN-2017C)"
 ],
 "confidence": "high",
 "notes": {
  "en": "A module only sends inputs once it is operational: press NMT start (or let the PLC do it). Only one device on a bus should poll a node with SDO and send its outputs: leave writing off where a PLC controls the module. RPDO1 sends all 16 outputs at once; after a restart the outputs' last states are restored first.",
  "zh-Hant": "模組要進入 operational 才會送輸入：按 NMT 啟動（或由 PLC 啟動）。同一條匯流排上只應有一個設備用 SDO 輪詢和送輸出：已有 PLC 控制的模組請不要允許寫入。RPDO1 一次送出全部 16 路輸出；重新啟動後會先還原輸出的最後狀態。"
 },
 "params": [
